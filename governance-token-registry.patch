+#!/usr/bin/expect -f
+# Expect script for bkpdir demo automation - Demo 2: Advanced Features
+# Demonstrates advanced features like comparison, restore, and configuration management
+# Usage: ./demo-automation-full.exp <DEMO_DIR> <BKPDIR_BIN> <PROJECT_ROOT> <CAST_FILE>
+
+set timeout 10
+set demo_dir [lindex $argv 0]
+set bkpdir_bin [lindex $argv 1]
+set project_root [lindex $argv 2]
+set cast_file [lindex $argv 3]
+
+# Start asciinema recording
+spawn asciinema rec --append $cast_file
+
+# Wait for prompt
+expect "$ "
+
+# set the shell's prompt to "$" and define the demo_stage and demo_bkpdir_cmd functions
+send "PS1='\$ '; demo_stage () { echo -e \"\r\\033\[1;32m\$@\\033\[0m\" ; } ; demo_bkpdir_cmd () { echo -e \"\r\\033\[1;35m\$@\\033\[0m\" ; }\r"
+expect "$ "
+
+send "clear\r"
+expect "$ "
+
+# Full second delay at the start
+sleep 1
+
+# describe the entire demo
+send "demo_stage 'This demo will show advanced bkpdir features: comparison, restore, and configuration management'\r"
+expect "$ "
+sleep 3
+
+# Navigate to demo directory
+send "demo_stage 'Navigating to demo directory'\r"
+expect "$ "
+
+send "cd $demo_dir\r"
+expect "$ "
+sleep 0.5
+
+# Create project structure
+send "mkdir -p myproject && cd myproject\r"
+expect "$ "
+sleep 0.5
+
+# Initialize git
+send "git init\r"
+expect "$ "
+sleep 1
+
+# Create sample files with more complexity
+send "demo_stage 'Creating project files'\r"
+expect "$ "
+send "echo '# My Project' > README.md\r"
+expect "$ "
+sleep 0.3
+send "echo 'package main' > main.go\r"
+expect "$ "
+sleep 0.3
+send "echo 'import \"fmt\"' >> main.go\r"
+expect "$ "
+sleep 0.3
+send "echo 'func main() { fmt.Println(\"Hello\") }' >> main.go\r"
+expect "$ "
+sleep 0.3
+send "mkdir -p src/components && echo 'export default Component' > src/components/Button.js\r"
+expect "$ "
+sleep 0.3
+send "echo 'export default Component' > src/components/Header.js\r"
+expect "$ "
+sleep 0.3
+send "mkdir -p tests && echo 'describe(\"tests\")' > tests/test.js\r"
+expect "$ "
+sleep 0.5
+
+# Initial git commit
+send "demo_stage 'Initial git commit'\r"
+expect "$ "
+send "git add .\r"
+expect "$ "
+sleep 0.5
+send "git commit -m 'Initial commit'\r"
+expect "$ "
+sleep 1.5
+
+# Create .bkpdir.yml with advanced configuration
+send "demo_stage 'Creating advanced .bkpdir.yml configuration'\r"
+expect "$ "
+send "cat > .bkpdir.yml << 'EOF'\r"
