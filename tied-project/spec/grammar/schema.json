{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IMPLFormalPseudocodeBlock",
  "description": "Normalized block from specparse (REQ-PSEUDOCODE_FORMAL_VERIFICATION)",
  "type": "object",
  "required": ["name", "line"],
  "properties": {
    "name": { "type": "string" },
    "specId": { "type": "string", "pattern": "^IMPL-[A-Z0-9_]+::[A-Z0-9_]+$" },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "action"],
        "properties": {
          "id": { "type": "string", "pattern": "^T[0-9]+$" },
          "action": { "type": "string" }
        }
      }
    },
    "pre": { "type": "array", "items": { "type": "string" } },
    "post": { "type": "array", "items": { "type": "string" } }
  }
}
